{
  "name": "order-school",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun --config=.github/lighthouserc.json",
    "check": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run test && npm run knip",
    "prepare": "husky",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.7",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^11.1.0",
    "@tanstack/react-form": "^1.23.7",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "image-size": "^2.0.4",
    "lucide-react": "^0.544.0",
    "next": "^16.3.7",
    "next-video": "^2.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "formdata-node": "^6.0.3",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "prettier": {
    "printWidth": 110,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app/globals.css",
    "tailwindFunctions": [
      "cn",
      "cva"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": [
            "tailwind",
            "theme",
            "utility",
            "variant",
            "custom-variant",
            "apply",
            "source",
            "plugin",
            "config",
            "reference"
          ]
        }
      ],
      "at-rule-no-deprecated": [
        true,
        {
          "ignoreAtRules": [
            "apply"
          ]
        }
      ],
      "at-rule-prelude-no-invalid": [
        true,
        {
          "ignoreAtRules": [
            "apply",
            "utility",
            "custom-variant"
          ]
        }
      ],
      "no-invalid-position-declaration": [
        true,
        {
          "ignoreAtRules": [
            "utility"
          ]
        }
      ],
      "function-no-unknown": [
        true,
        {
          "ignoreFunctions": [
            "theme",
            "--theme",
            "--spacing",
            "--alpha"
          ]
        }
      ],
      "import-notation": "string",
      "custom-property-empty-line-before": null,
      "declaration-empty-line-before": null,
      "color-hex-length": null,
      "no-descending-specificity": null
    }
  },
  "knip": {
    "ignoreIssues": {
      "src/components/ui/**": [
        "exports",
        "types"
      ]
    }
  },
  "allowScripts": {
    "@tailwindcss/oxide": true,
    "unrs-resolver": true,
    "fsevents": true
  }
}
