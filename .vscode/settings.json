{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "css.validate": false,
  "stylelint.validate": ["css"],
  "files.associations": { "*.css": "tailwindcss" },
  "tailwindCSS.classFunctions": ["cn", "cva"],
  "typescript.tsdk": "node_modules/typescript/lib",

  // Generated files and local reports: never edited by hand
  "files.exclude": {
    "**/.next": true,
    "tsconfig.tsbuildinfo": true,
    "next-env.d.ts": true,
    ".lighthouseci": true,
    "playwright-report": true,
    "test-results": true
  },

  // Tool configs fold under the file they belong to
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, .nvmrc, .editorconfig, .gitignore, .prettierignore, eslint.config.*, components.json",
    "next.config.ts": "postcss.config.*, next-env.d.ts",
    "tsconfig.json": "tsconfig.*.json, tsconfig.tsbuildinfo",
    "vitest.config.mts": "playwright.config.*",
    "README.md": "LICENSE, CHANGELOG.md"
  }
}
